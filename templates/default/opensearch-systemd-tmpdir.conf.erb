# Generated by Chef - Local modifications will be overwritten
#
# opensearch-env derives OPENSEARCH_TMPDIR from `mktemp -d` under /tmp, which
# is mounted noexec on CIS-hardened hosts. Pin it to the cookbook-managed
# executable directory so the launcher and OPENSEARCH_TMPDIR-reading plugins
# stop using /tmp.
[Service]
Environment=OPENSEARCH_TMPDIR=<%= @java_tmp_dir %>
