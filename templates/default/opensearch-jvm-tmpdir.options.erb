# Generated by Chef - Local modifications will be overwritten
#
# Overrides java.io.tmpdir so the JVM does not unpack and execute native
# libraries under /tmp, which is mounted noexec on CIS-hardened hosts and
# Amazon Linux 2023. Read from jvm.options.d after the package's own
# jvm.options; the last -D wins.
-Djava.io.tmpdir=<%= @java_tmp_dir %>
